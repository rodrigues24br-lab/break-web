# App
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/idXXXXXXXX
# Force mock auth/checkout without Firebase/Stripe. Leave unset/false when Firebase is configured.
NEXT_PUBLIC_MOCK_MODE=

# Firebase (client)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin (server — webhook Pro grants)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Use \n for newlines in the private key string
FIREBASE_PRIVATE_KEY=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Annual Price ID (legacy alias: STRIPE_PRICE_ID). If empty, Checkout uses $49.99/year price_data.
STRIPE_PRICE_ID=
STRIPE_PRICE_ID_ANNUAL=
# Monthly Price ID. If empty, Checkout uses $5.99/month price_data.
STRIPE_PRICE_ID_MONTHLY=

# FirstPromoter (default cid p7zpnc3j if unset — see src/lib/config.ts)
NEXT_PUBLIC_FIRSTPROMOTER_ACCOUNT_ID=
