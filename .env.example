# App
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/idXXXXXXXX
# Only set to true to force mock auth UI. Unset/false = live UI (no demo banner).
NEXT_PUBLIC_MOCK_MODE=

# Firebase (client) — optional for demo banner; needed for real browser Auth
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=break-99b8e.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin (server — webhook Pro grants)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Use \n for newlines in the private key string
FIREBASE_PRIVATE_KEY=

# Stripe (Vercel exact names)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Annual Break Pro Price ID (legacy alias: STRIPE_PRICE_ID). Default used if unset.
STRIPE_PRICE_ID=price_1UQFdLBMIFugty3a7b54OLdG
STRIPE_PRICE_ID_ANNUAL=price_1UQFdLBMIFugty3a7b54OLdG

# FirstPromoter (Vercel exact names — preferred)
FIRSTPROMOTER_ACCOUNT_ID=
FIRSTPROMOTER_API_KEY=
# Local fallback for client builds if needed
NEXT_PUBLIC_FIRSTPROMOTER_ACCOUNT_ID=
