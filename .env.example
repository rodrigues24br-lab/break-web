# App
NEXT_PUBLIC_SITE_URL=https://breakapplimit.com
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/us/app/break-app-limit/id6811685502
# Only set to true to force mock auth UI + simulated checkout. Unset/false = live.
NEXT_PUBLIC_MOCK_MODE=

# Firebase Web (project break-99b8e) — required for real Auth on Vercel
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=break-99b8e.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=break-99b8e
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=break-99b8e.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin (server — Stripe webhook Pro grants to Firestore)
# Prefer full service-account JSON (Vercel): paste the downloaded key file contents
FIREBASE_SERVICE_ACCOUNT_KEY=
# Or discrete vars (local/dev fallback):
FIREBASE_PROJECT_ID=break-99b8e
FIREBASE_CLIENT_EMAIL=
# Use \n for newlines in the private key string
FIREBASE_PRIVATE_KEY=

# Stripe (Vercel exact names) — required for live Checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional for hosted Checkout (used only if client Stripe.js is mounted)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Annual Break Pro Price ID (legacy alias: STRIPE_PRICE_ID)
STRIPE_PRICE_ID=price_1UQFdLBMIFugty3a7b54OLdG
STRIPE_PRICE_ID_ANNUAL=price_1UQFdLBMIFugty3a7b54OLdG

# FirstPromoter (Vercel exact names)
FIRSTPROMOTER_ACCOUNT_ID=
FIRSTPROMOTER_API_KEY=
# Optional HMAC secret for /api/firstpromoter-webhook (falls back to API key)
# FIRSTPROMOTER_WEBHOOK_SECRET=
# Local fallback for client builds if FIRSTPROMOTER_ACCOUNT_ID is server-only
NEXT_PUBLIC_FIRSTPROMOTER_ACCOUNT_ID=
